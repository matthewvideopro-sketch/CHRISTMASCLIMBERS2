;letter-spacing:.14em;color:var(--red);text-transform:uppercase;margin-bottom:12px;}.hw-po p{position:relative;font-size:16px;line-height:1.6;color:var(--muted);max-width:470px;margin:0 auto;}.hw-po .cta{position:relative;overflow:hidden;display:inline-block;margin-top:20px;background:var(--gold);color:#111111;font-family:'Fredoka',serif;font-weight:700;letter-spacing:.04em;font-size:15px;padding:13px 30px;border-radius:8px;text-decoration:none;transition:transform .2s,box-shadow .2s;box-shadow:0 6px 22px rgba(193,18,31,.35);}.hw-po .cta:hover{transform:translateY(-2px);box-shadow:0 10px 30px rgba(193,18,31,.5);}.hw-po .cta::after{content:'';position:absolute;top:0;left:-120%;width:55%;height:100%;background:linear-gradient(120deg,transparent,rgba(255,255,255,.35),transparent);transform:skewX(-20deg);animation:hwShine 3.4s ease-in-out infinite;}@keyframes hwShine{0%{left:-120%}45%,100%{left:135%}}.hw-po .note{position:relative;font-size:12px;letter-spacing:.06em;color:#7d757b;margin-top:12px;text-transform:uppercase;}@media (prefers-reduced-motion:reduce){.hw-po .veil,.hw-po .paws span,.hw-po .badge i,.hw-po .cta::after{animation:none;}.hw-po .paws span{opacity:.7}}</style><div class=\"hw-po\"><span class=\"veil\"></span><span class=\"badge\"><i></i>Pre-order &middot; 50% off</span><div class=\"paws\"><span>🎄</span><span>✨</span><span>🎅</span><span>✨</span><span>🎄</span></div><h3>Make Their Christmas Glow</h3><div class=\"sub\">A glowing climbing Santa & Elf, made to light up the whole season.</div><div class=\"off\">50% off every pre-order</div><p>Light up your entryway, window, or porch. Enjoy 50% off when you pre-order. ✨</p><a class=\"cta\" href=\"#\" onclick=\"window.scrollTo({top:0,behavior:'smooth'});return false;\">Reserve mine &middot; 50% off</a><div class=\"note\">limited runs each month</div></div>",
